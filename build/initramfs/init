#!/bin/sh
# Helix OS — Live Boot Init
# Runs inside the initramfs before switching to real root.
# Mirrors Unraid's boot model: USB → squashfs → RAM → overlayfs → pivot.

export PATH=/bin:/sbin:/usr/bin:/usr/sbin

BOOT_LABEL="HELIXBOOT"
SQUASHFS_PATH="boot/filesystem.squashfs"
TIMEOUT=30

# With the boot splash running, progress text goes to a log (and the kernel log) instead of over the animation.
SPLASH=0
msg()  { [ -d /run/helix ] && echo "[helix] $*" >> /run/helix/init.log; [ "$SPLASH" = 1 ] && { echo "[helix] $*" > /dev/kmsg 2>/dev/null; return 0; }; echo "[helix] $*"; }
warn() { [ -d /run/helix ] && echo "[helix] WARN: $*" >> /run/helix/init.log; [ "$SPLASH" = 1 ] && { echo "[helix] WARN: $*" > /dev/kmsg 2>/dev/null; return 0; }; echo "[helix] WARN: $*" >&2; }
die()  {
    [ "$SPLASH" = 1 ] && { plymouth quit 2>/dev/null; cat /run/helix/init.log 2>/dev/null; }
    echo "[helix] FATAL: $*" >&2; exec /bin/sh
}

# ── 1. Essential pseudo-filesystems ──────────────────────────────────────────
mount -t devtmpfs  devtmpfs /dev
mount -t proc      proc     /proc
mount -t sysfs     sysfs    /sys
mount -t tmpfs     tmpfs    /run
mkdir -p /run/helix/usb /run/helix/ro /run/helix/rw

# ── 1b. Boot splash (Plymouth): animated helix while the system loads ────────────
# Needs "splash" on the kernel command line and plymouth in this initramfs. A display driver is loaded first
# (simpledrm takes over the firmware framebuffer; bochs/virtio-gpu/... cover virtual machines).
case " $(cat /proc/cmdline) " in *" splash "*) [ -x /usr/sbin/plymouthd ] && SPLASH=1 ;; esac
if [ "$SPLASH" = 1 ]; then
    for mod in simpledrm bochs virtio_gpu cirrus vmwgfx hyperv_drm vc4; do modprobe "$mod" 2>/dev/null || true; done
    i=0
    while [ $i -lt 8 ] && [ ! -e /dev/dri/card0 ] && [ ! -e /dev/fb0 ]; do sleep 1; i=$((i + 1)); done
    if [ -e /dev/dri/card0 ] || [ -e /dev/fb0 ]; then
        mkdir -p /run/plymouth
        # Plymouth only uses a graphics device that udev has marked "initialized", and there is no udev daemon in this
        # initramfs. Mark each DRM device ourselves (a small entry in udev's database: initialized + the "seat" tags); the real udev rewrites it later.
        mkdir -p /run/udev/data
        for d in /sys/class/drm/card[0-9]*; do
            [ -f "$d/dev" ] && printf 'I:1\nG:seat\nG:master-of-seat\nQ:seat\nQ:master-of-seat\n' > "/run/udev/data/c$(cat "$d/dev")"
        done
        # Foreground mode in the background: the daemonizing mode needs a controlling terminal, which init does not have.
        plymouthd --mode=boot --pid-file=/run/plymouth/pid --no-daemon > /run/plymouth/out.log 2>&1 &
        i=0; while [ $i -lt 6 ] && ! plymouth --ping 2>/dev/null; do sleep 1; i=$((i + 1)); done
        plymouth --ping 2>/dev/null && plymouth show-splash 2>/dev/null || SPLASH=0
    else
        SPLASH=0                                  # no display device: fall back to the normal text boot
    fi
fi

# ── 2. Kernel modules ─────────────────────────────────────────────────────────
# Load filesystem modules AND the storage/controller drivers needed to see the
# boot device. Without the controller drivers (VirtIO on KVM/Proxmox, AHCI/SATA,
# NVMe, USB, SD/MMC) the HELIXBOOT device never appears and the search below
# times out. devtmpfs creates the device nodes automatically as each driver
# attaches, so no udev is required.
for mod in \
    virtio_pci virtio_mmio virtio_blk virtio_scsi virtio_net \
    ahci ata_piix ata_generic ata_sil ata_sis pata_acpi libata \
    scsi_mod sd_mod sr_mod cdrom \
    nvme_core nvme \
    usb_common usbcore ehci_pci ehci_hcd ohci_pci ohci_hcd uhci_hcd \
    xhci_pci xhci_hcd usb_storage uas hid_generic usbhid \
    mmc_core mmc_block sdhci sdhci_pci sdhci_acpi sdhci_pltfm \
    sdhci_of_arasan sdhci_iproc bcm2835_sdhost dw_mmc dw_mmc_pltfm \
    aesni_intel cryptd crc32c_intel crc32c \
    megaraid_sas mvsas qla2xxx jmb38x_ms firewire_ohci \
    hv_storvsc hv_netvsc xen_blkfront xen_netfront \
    bnx2 bnx2x ixgbe i40e mlx4_core mlx4_en mlx5_core \
    ipv6 nf_conntrack nf_nat \
    squashfs overlay loop vfat exfat isofs nls_cp437 nls_ascii nls_utf8; do
    modprobe "$mod" 2>/dev/null || true
done
# Allow USB devices time to enumerate before scanning
sleep 2

# Run mdev to discover all block devices + partition nodes from /sys/block.
# Without this, only the base disk devices (sda, sdb) appear in /dev/ — the
# partition nodes (sda1, sda2) don't exist yet and blkid can't scan them.
mdev -s 2>/dev/null || true

# Force kernel to re-read partition tables for any disk missing partition nodes.
for disk in /dev/sd[a-z] /dev/vd[a-z] /dev/hd[a-z] /dev/nvme[0-9]n[0-9]; do
    [ -b "$disk" ] || continue
    base=$(basename "$disk")
    ls /dev/${base}[0-9] >/dev/null 2>&1 && continue   # partitions already exist
    blockdev --rereadpt "$disk" 2>/dev/null || true
done
sleep 1  # give partition nodes a moment to appear

# Let asynchronous probing (USB/VirtIO enumeration) settle before scanning.
udevadm trigger 2>/dev/null || true
udevadm settle --timeout=10 2>/dev/null || true

# ── 3. Wait for boot device (by filesystem label) ────────────────────────────
msg "Searching for boot device (label=$BOOT_LABEL, timeout=${TIMEOUT}s)..."
# Resolve the boot device by filesystem label. busybox blkid does not support
# `-L`, so try several methods: util-linux blkid -L, busybox findfs, then a
# parse of plain `blkid` output.
find_boot_dev() {
    local dev lbl

    # Method 1: util-linux blkid -L (not supported by busybox blkid)
    dev=$(blkid -L "$BOOT_LABEL" 2>/dev/null) && [ -n "$dev" ] && { echo "$dev"; return; }

    # Method 2: findfs (busybox applet, works reliably)
    dev=$(findfs "LABEL=$BOOT_LABEL" 2>/dev/null) && [ -n "$dev" ] && { echo "$dev"; return; }

    # Method 3: plain blkid scan — busybox outputs LABEL=X (no quotes),
    # util-linux outputs LABEL="X" — match both forms.
    dev=$(blkid 2>/dev/null | grep -i "LABEL=" | grep -i "$BOOT_LABEL" | head -1 | cut -d: -f1)
    [ -n "$dev" ] && { echo "$dev"; return; }

    # Method 4: brute-force — try blkid then mount-probe every partition.
    # CD-ROM devices (/dev/sr*) are excluded from the mount probe: an empty
    # drive causes the kernel to print "can't open blockdev" to the console
    # (a printk, not stderr — cannot be suppressed from shell). They are
    # already covered by methods 1-3 above when a disc is inserted.
    mkdir -p /run/probe
    for d in /dev/sd[a-z][0-9] /dev/sd[a-z] \
              /dev/vd[a-z][0-9] /dev/vd[a-z] \
              /dev/hd[a-z][0-9] /dev/hd[a-z] \
              /dev/mmcblk[0-9]p[0-9] \
              /dev/nvme[0-9]n[0-9]p[0-9] \
              /dev/sr[0-9]; do
        [ -b "$d" ] || continue
        # blkid per-device: suppress both stdout and stderr to avoid noise
        lbl=$(blkid "$d" 2>/dev/null | grep -i "LABEL=" | grep -i "$BOOT_LABEL")
        [ -n "$lbl" ] && { echo "$d"; return; }
        # Skip CD-ROM mount probe (kernel prints errors for empty drives)
        case "$d" in /dev/sr*) continue ;; esac
        # Mount probe: look for the squashfs file as proof of HELIXBOOT
        for fstype in vfat iso9660 auto; do
            if mount -t "$fstype" -o ro,noatime "$d" /run/probe 2>/dev/null; then
                if [ -f "/run/probe/$SQUASHFS_PATH" ]; then
                    umount /run/probe 2>/dev/null || true
                    echo "$d"; return
                fi
                umount /run/probe 2>/dev/null || true
            fi
        done
    done
}

USB_DEV=""
i=0
while [ $i -lt $TIMEOUT ]; do
    USB_DEV=$(find_boot_dev)
    [ -n "$USB_DEV" ] && break
    # Re-trigger enumeration periodically (no-op under busybox mdev).
    udevadm trigger 2>/dev/null || true
    sleep 1
    i=$((i + 1))
done
if [ -z "$USB_DEV" ]; then
    warn "Boot device (label=$BOOT_LABEL) not found. Visible block devices:"
    blkid 2>/dev/null >&2 || true
    die "Boot device (label=$BOOT_LABEL) not found after ${TIMEOUT}s."
fi
msg "Found boot device: $USB_DEV"

# ── 4. Mount boot device read-only (vfat for USB/disk, iso9660 for ISO/CD) ───
BOOT_FS_READONLY=false
MOUNTED=false
for fstype in vfat iso9660 auto; do
    # FAT has no unix owners: give the whole partition to uid/gid 1000 (the helix
    # user) so the unprivileged web backend can write /boot/config. FAT only honours
    # uid/gid at the first mount, never on a later remount.
    mopts="ro,noatime"; [ "$fstype" = "vfat" ] && mopts="ro,noatime,uid=1000,gid=1000,fmask=0022,dmask=0022"
    if mount -t "$fstype" -o "$mopts" "$USB_DEV" /run/helix/usb 2>/dev/null; then
        MOUNTED=true
        [ "$fstype" = "iso9660" ] && BOOT_FS_READONLY=true
        break
    fi
done
$MOUNTED || die "Cannot mount $USB_DEV (tried vfat, iso9660, auto)"
msg "Mounted $USB_DEV (readonly=$BOOT_FS_READONLY)"

# ── 5. Pick squashfs (fall back to previous image if an update was interrupted) ─
# The GitHub updater keeps the prior image as *.prev and sets an inflight flag
# while swapping. If that swap did not finish, or the new image is missing,
# boot the previous one instead of failing.
SQUASHFS_SRC="/run/helix/usb/$SQUASHFS_PATH"
SQUASHFS_PREV="/run/helix/usb/${SQUASHFS_PATH}.prev"
if [ -f "/run/helix/usb/boot/.helix-update-inflight" ] && [ -f "$SQUASHFS_PREV" ]; then
    warn "Interrupted update detected — booting previous image (.prev)."
    SQUASHFS_SRC="$SQUASHFS_PREV"
elif [ ! -f "$SQUASHFS_SRC" ] && [ -f "$SQUASHFS_PREV" ]; then
    warn "$SQUASHFS_PATH missing — booting previous image (.prev)."
    SQUASHFS_SRC="$SQUASHFS_PREV"
fi
[ -f "$SQUASHFS_SRC" ] || die "No bootable filesystem.squashfs on boot device."

# Copying to RAM means the USB/CD can be removed after boot (Unraid behaviour).
SQUASHFS_SIZE=$(du -k "$SQUASHFS_SRC" | cut -f1)
msg "Loading filesystem (~${SQUASHFS_SIZE}K) into RAM..."
mkdir -p /run/helix/img
mount -t tmpfs -o "size=$((SQUASHFS_SIZE * 2))k" tmpfs /run/helix/img
cp "$SQUASHFS_SRC" /run/helix/img/filesystem.squashfs

# ── 6. Mount squashfs (read-only base layer); on failure, try the previous one ─
if ! mount -t squashfs -o loop,ro /run/helix/img/filesystem.squashfs /run/helix/ro; then
    if [ "$SQUASHFS_SRC" != "$SQUASHFS_PREV" ] && [ -f "$SQUASHFS_PREV" ]; then
        warn "New image failed to mount — falling back to previous image (.prev)."
        cp "$SQUASHFS_PREV" /run/helix/img/filesystem.squashfs
        mount -t squashfs -o loop,ro /run/helix/img/filesystem.squashfs /run/helix/ro \
            || die "Cannot mount squashfs (including .prev fallback)."
    else
        die "Cannot mount squashfs."
    fi
fi

# ── 7. Set up overlayfs (RAM layer on top) ───────────────────────────────────
mount -t tmpfs -o mode=0755 tmpfs /run/helix/rw
mkdir -p /run/helix/rw/upper /run/helix/rw/work
mount -t overlay overlay \
    -o "lowerdir=/run/helix/ro,upperdir=/run/helix/rw/upper,workdir=/run/helix/rw/work" \
    /root \
    || die "Cannot mount overlay filesystem."

# ── 8. Mount boot device read-write, bind as /boot (config lives here) ───────
# ISO 9660 is inherently read-only; skip the remount (config writes will fail
# gracefully — live ISO sessions run without persistent config).
if [ "$BOOT_FS_READONLY" = "false" ]; then
    mount -o remount,rw "$USB_DEV" /run/helix/usb
fi
mkdir -p /root/boot
# --move, not --bind: a bind leaves the original mount stranded at /run/helix/usb
# in the discarded initramfs tree. Nothing can reach it to unmount it, so the boot
# partition could never be released (no resize, fsck or reflash while running).
mount --move /run/helix/usb /root/boot

# ── 9. Move pseudo-filesystems into new root ─────────────────────────────────
mkdir -p /root/dev /root/proc /root/sys /root/run
mount --move /dev  /root/dev
mount --move /proc /root/proc
mount --move /sys  /root/sys
# /run stays — the overlayfs, squashfs tmpfs, and rw tmpfs are mounted under it;
# switch_root cleans up the initramfs but those mounts survive as they are
# referenced by the new root's overlayfs.

# ── 10. Run /boot/config/go if present (like Unraid's startup script) ─────────
if [ -f /root/boot/config/go ]; then
    msg "Found /boot/config/go — will execute after pivot."
    # We can't run it here; it runs from real root via rc.local/systemd
fi

msg "Switching to live filesystem..."
# Hand the splash over to the real system: it keeps running until systemd's plymouth-quit.service ends it.
[ "$SPLASH" = 1 ] && plymouth update-root-fs --new-root-dir=/root 2>/dev/null
exec switch_root /root /sbin/init
die "switch_root failed — dropping to emergency shell."
