#!/usr/bin/env python3
"""helix-addin: install optional software (add-ins) onto the RAM-root OS and keep it across reboots.

Runs as root (the web backend calls it through sudo). The root filesystem lives in RAM, so an
add-in is downloaded once, its .deb files are kept on the array (<cache|disk1>/system/addins/<id>/),
and `restore` re-installs them from that folder at every array start, with no network needed.

  helix-addin install <id>    manifest JSON on stdin
  helix-addin adopt   <id>    manifest JSON on stdin: the packages are already installed (by hand or by an
                              install that stopped early); cache exactly what is installed and record it,
                              without reinstalling anything (CLAUDE.md §56)
  helix-addin remove  <id>
  helix-addin restore         (called by helix-array-start; runs in the background)
  helix-addin status          JSON: what is installed, where its cache is

A manifest entry is data only: apt sources, package names and a short list of named post-install
actions. Nothing in it is ever run as a shell command, so a bad manifest cannot run code as root.
"""
import glob
import json
import os
import re
import subprocess
import sys
import time
import urllib.parse

HELIX_CONFIG = os.environ.get("HELIX_CONFIG", "/boot/config")
STATE_FILE = os.path.join(HELIX_CONFIG, "addins.json")
ALLOWED_HOSTS = {"deb.debian.org", "security.debian.org", "nvidia.github.io", "developer.download.nvidia.com"}
ALLOWED_POST = {"depmod", "swap-nouveau", "docker-nvidia-runtime"}
ID_RE = re.compile(r"^[a-z0-9][a-z0-9-]{0,31}$")
PKG_RE = re.compile(r"^[a-z0-9][a-zA-Z0-9.+:$()-]{0,80}$")


def log(msg):
    print(msg, flush=True)


def run(cmd, check=True, **kw):
    log("$ " + " ".join(cmd))
    r = subprocess.run(cmd, text=True, stdout=subprocess.PIPE, stderr=subprocess.STDOUT, **kw)
    out = r.stdout.rstrip()
    if out:
        # Keep the start too: with ~100 packages the first error is what matters.
        log(out if len(out) <= 8000 else out[:3000] + "\n[... output trimmed ...]\n" + out[-5000:])
    if check and r.returncode != 0:
        raise SystemExit(f"FAILED ({r.returncode}): {' '.join(cmd)}")
    return r


def subst(s):
    arch = subprocess.run(["dpkg", "--print-architecture"], text=True, capture_output=True).stdout.strip()
    return (s.replace("$(KVER)", os.uname().release).replace("$(ARCH)", arch)
             .replace("$(CODENAME)", "bookworm"))


def validate(e):
    """Return a cleaned copy of a manifest entry or raise SystemExit with the reason."""
    if not isinstance(e, dict) or not ID_RE.match(str(e.get("id", ""))):
        raise SystemExit("invalid add-in id")
    apt = e.get("apt") or {}
    pkgs = apt.get("packages") or []
    if not pkgs or not all(isinstance(p, str) and PKG_RE.match(p) for p in pkgs):
        raise SystemExit("invalid package list")
    srcs = []
    for s in apt.get("sources") or []:
        name = str(s.get("name", ""))
        line = str(s.get("line", ""))
        if not re.match(r"^[a-z0-9-]{1,32}$", name):
            raise SystemExit("invalid source name")
        m = re.match(r"^deb (\[[^\]\n]*\] )?(https?://[^ \n]+)( [^\n]+)?$", line)
        if not m or urllib.parse.urlparse(m.group(2)).hostname not in ALLOWED_HOSTS:
            raise SystemExit(f"source not allowed: {line[:80]}")
        key = s.get("key_url")
        if key and (urllib.parse.urlparse(key).scheme != "https" or urllib.parse.urlparse(key).hostname not in ALLOWED_HOSTS):
            raise SystemExit("key url not allowed")
        srcs.append({"name": name, "line": line, "key_url": key})
    post = e.get("post") or []
    if not all(p in ALLOWED_POST for p in post):
        raise SystemExit("unknown post-install action")
    return {"id": e["id"], "title": str(e.get("title", e["id"]))[:80], "version": str(e.get("version", "1")),
            "apt": {"sources": srcs, "packages": pkgs}, "post": post, "reboot": bool(e.get("reboot"))}


def storage_root():
    forced = os.environ.get("HELIX_ADDIN_ROOT")
    if forced:
        return forced
    for pat in ("/mnt/cache[0-9]*", "/mnt/disk[0-9]*"):
        for m in sorted(glob.glob(pat)):
            if os.path.ismount(m):
                return os.path.join(m, "system", "addins")
    raise SystemExit("Start the array first: add-ins are stored on the array so they survive a reboot.")


def load_state():
    try:
        return json.load(open(STATE_FILE))
    except (OSError, ValueError):
        return {}


def save_state(st):
    os.makedirs(HELIX_CONFIG, exist_ok=True)
    tmp = STATE_FILE + ".tmp"
    json.dump(st, open(tmp, "w"), indent=1)
    os.replace(tmp, STATE_FILE)


def write_sources(e):
    for s in e["apt"]["sources"]:
        line = subst(s["line"])
        if s["key_url"]:
            keyfile = f"/usr/share/keyrings/helix-{e['id']}-{s['name']}.asc"
            run(["curl", "-fsSL", "--retry", "3", "-o", keyfile, s["key_url"]])
            line = line.replace("KEYRING", keyfile)
        open(f"/etc/apt/sources.list.d/helix-{e['id']}-{s['name']}.list", "w").write(line + "\n")


def post_actions(e):
    for p in e["post"]:
        if p == "depmod":
            run(["depmod", "-a"], check=False)
        elif p == "swap-nouveau":
            # nouveau is loaded by udev before this runs; the NVIDIA driver cannot bind while it is.
            open("/etc/modprobe.d/helix-blacklist-nouveau.conf", "w").write("blacklist nouveau\noptions nouveau modeset=0\n")
            run(["modprobe", "-r", "nouveau"], check=False)
            run(["modprobe", "nvidia"], check=False)
        elif p == "docker-nvidia-runtime" and os.path.exists("/usr/bin/nvidia-ctk"):
            before = open("/etc/docker/daemon.json").read() if os.path.exists("/etc/docker/daemon.json") else ""
            run(["nvidia-ctk", "runtime", "configure", "--runtime=docker"], check=False)
            after = open("/etc/docker/daemon.json").read() if os.path.exists("/etc/docker/daemon.json") else ""
            if before != after and subprocess.run(["systemctl", "is-active", "--quiet", "docker"]).returncode == 0:
                run(["systemctl", "restart", "docker"], check=False)


def install_debs(cache):
    debs = sorted(glob.glob(os.path.join(cache, "archives", "*.deb")))
    if not debs:
        raise SystemExit("no packages in the cache")
    env = dict(os.environ, DEBIAN_FRONTEND="noninteractive")
    # One `dpkg -i` over the whole cache fails on Pre-Depends (glx-diversions needs glx-alternative-mesa
    # configured before it is unpacked), which broke every restore. apt orders the set itself and,
    # given local paths with --no-download, never touches the network.
    r = run(["apt-get", "install", "-y", "--no-download", "--no-install-recommends", "--allow-downgrades",
             "-o", "Dpkg::Options::=--force-confold", *debs], check=False, env=env)
    if r.returncode == 0:
        return
    log("apt-get could not install the cached set; falling back to dpkg in two passes")
    run(["dpkg", "--force-confold", "-i", *debs], check=False, env=env)
    run(["dpkg", "--force-confold", "-i", *debs], env=env)
    run(["dpkg", "--configure", "-a"], env=env)


IMAGE_SQUASHFS = "/boot/boot/filesystem.squashfs"


def installed_versions() -> dict:
    out = subprocess.run(["dpkg-query", "-W", "-f=${db:Status-Abbrev}\t${Package}\t${Version}\n"],
                         text=True, capture_output=True).stdout
    return {p: v for st, p, v in (l.split("\t") for l in out.splitlines() if l.count("\t") == 2) if st.startswith("ii")}


def image_versions() -> dict | None:
    """Packages and versions the running OS image itself ships (its own dpkg status, read from the
    squashfs on the boot device). None if that cannot be read."""
    try:
        r = subprocess.run(["unsquashfs", "-cat", IMAGE_SQUASHFS, "var/lib/dpkg/status"],
                           text=True, capture_output=True, timeout=120)
    except (OSError, subprocess.TimeoutExpired):
        return None
    if r.returncode != 0 or "Package:" not in r.stdout:
        return None
    out, pkg, ver, ok = {}, None, None, False
    for line in r.stdout.splitlines() + [""]:
        if not line:
            if pkg and ok:
                out[pkg] = ver
            pkg, ver, ok = None, None, False
        elif line.startswith("Package: "):
            pkg = line[9:].strip()
        elif line.startswith("Version: "):
            ver = line[9:].strip()
        elif line.startswith("Status: "):
            ok = line.endswith("install ok installed")
    return out


def closure(pkgs: list) -> set:
    """Every package the add-in's packages depend on (Depends/PreDepends), recursively."""
    r = subprocess.run(["apt-cache", "depends", "--recurse", "--no-recommends", "--no-suggests", "--no-conflicts",
                        "--no-breaks", "--no-replaces", "--no-enhances", *pkgs], text=True, capture_output=True)
    names = set(pkgs)
    for line in r.stdout.splitlines():
        if line and not line.startswith(" "):
            names.add(line.strip())
        elif "Depends:" in line:
            names.add(line.split(":", 1)[1].strip().strip("<>"))
    return {n for n in names if PKG_RE.match(n)}


def fill_cache(e: dict, cache: str) -> int:
    """Put the .deb of every package this add-in added to the OS (or upgraded), at the version that is
    installed now, into <cache>/archives. Built in archives.new and swapped in only when complete, so a
    failure never leaves the add-in without its previous cache. Returns the number of packages."""
    pkgs = [subst(p) for p in e["apt"]["packages"]]
    now = installed_versions()
    missing = [p for p in pkgs if p not in now]
    if missing:
        raise SystemExit("not installed: " + " ".join(missing))
    image = image_versions()
    if image is None:
        log("  (cannot read the OS image's package list; caching every dependency, which is larger)")
        image = {}
    need = sorted(n for n in closure(pkgs) if n in now and image.get(n) != now[n])
    new, cur, old = (os.path.join(cache, d) for d in ("archives.new", "archives", "archives.old"))
    subprocess.run(["rm", "-rf", new, old])
    os.makedirs(new)
    log(f"  caching {len(need)} packages")
    # apt-get download writes into the current directory; one call, exact versions.
    r = run(["apt-get", "download", *[f"{n}={now[n]}" for n in need]], check=False, cwd=new)
    got = {re.sub(r"_.*", "", os.path.basename(f)) for f in glob.glob(os.path.join(new, "*.deb"))}
    lost = [n for n in need if n not in got]
    if r.returncode != 0 or lost:
        # A version no longer offered by the mirror (e.g. after a point release): take it from apt's own cache.
        for n in list(lost):
            for f in glob.glob(f"/var/cache/apt/archives/{n}_*.deb"):
                if subprocess.run(["dpkg-deb", "-f", f, "Version"], text=True, capture_output=True).stdout.strip() == now[n]:
                    subprocess.run(["cp", f, new]); lost.remove(n); break
    if lost:
        subprocess.run(["rm", "-rf", new])
        raise SystemExit("could not get these packages at the installed version: " + " ".join(lost))
    if os.path.isdir(cur):
        os.rename(cur, old)
    os.rename(new, cur)
    subprocess.run(["rm", "-rf", old])
    return len(need)


def record(e: dict, cache: str, count: int):
    size = sum(os.path.getsize(f) for f in glob.glob(os.path.join(cache, "archives", "*.deb")))
    e = dict(e, kver=os.uname().release)
    json.dump(e, open(os.path.join(cache, "entry.json"), "w"), indent=1)
    st = load_state()
    st[e["id"]] = {"version": e["version"], "kver": e["kver"], "installed": int(time.time()), "cache": cache,
                   "bytes": size, "packages": count}
    save_state(st)


def cmd_install(aid):
    e = validate(json.load(sys.stdin))
    if e["id"] != aid:
        raise SystemExit("id mismatch")
    root = storage_root()
    cache = os.path.join(root, e["id"])
    os.makedirs(cache, exist_ok=True)
    log("STEP 1/5 Adding package sources")
    write_sources(e)
    log("STEP 2/5 Reading package lists")
    run(["apt-get", "update"], check=False)
    log("STEP 3/5 Installing")
    pk = [subst(p) for p in e["apt"]["packages"]]
    env = dict(os.environ, DEBIAN_FRONTEND="noninteractive")
    run(["apt-get", "install", "-y", "--no-install-recommends", "-o", "Dpkg::Options::=--force-confold", *pk], env=env)
    log("STEP 4/5 Keeping a copy on the array")
    # Record before the post-install actions: if one of those fails, the add-in is still installed
    # and must come back at the next boot (an install that stopped here left no record, CLAUDE.md §53).
    record(e, cache, fill_cache(e, cache))
    log("STEP 5/5 Finishing")
    post_actions(e)
    log("DONE" + (" - reboot to finish" if e["reboot"] else ""))


def cmd_adopt(aid):
    e = validate(json.load(sys.stdin))
    if e["id"] != aid:
        raise SystemExit("id mismatch")
    cache = os.path.join(storage_root(), e["id"])
    os.makedirs(cache, exist_ok=True)
    log("STEP 1/3 Package sources")
    write_sources(e)
    run(["apt-get", "update"], check=False)
    log("STEP 2/3 Keeping a copy of the installed packages on the array")
    n = fill_cache(e, cache)
    log("STEP 3/3 Recording")
    record(e, cache, n)
    log(f"DONE - {n} packages kept; they are re-installed at every array start")


def cmd_restore():
    st = load_state()
    for aid, rec in st.items():
        try:
            e = json.load(open(os.path.join(rec["cache"], "entry.json")))
        except (OSError, ValueError):
            log(f"{aid}: cache missing, skipping (reinstall it from the page)")
            continue
        if e.get("kver") != os.uname().release:
            log(f"{aid}: built for kernel {e.get('kver')}, running {os.uname().release}; reinstall it from the page")
            continue
        log(f"{aid}: restoring from {rec['cache']}")
        try:
            install_debs(rec["cache"])
            post_actions(validate(e))
            log(f"{aid}: restored")
        except SystemExit as ex:
            log(f"{aid}: restore failed: {ex}")


def cmd_remove(aid):
    st = load_state()
    rec = st.pop(aid, None)
    if rec:
        try:
            e = validate(json.load(open(os.path.join(rec["cache"], "entry.json"))))
            names = [re.sub(r"_.*", "", os.path.basename(f)) for f in glob.glob(os.path.join(rec["cache"], "archives", "*.deb"))]
            run(["dpkg", "--purge", "--force-depends", *[n for n in names if n in {subst(p) for p in e["apt"]["packages"]}]], check=False)
        except (OSError, ValueError, SystemExit):
            pass
        run(["rm", "-rf", rec["cache"]], check=False)
    for f in glob.glob(f"/etc/apt/sources.list.d/helix-{aid}-*.list"):
        os.remove(f)
    save_state(st)
    log("DONE")


def main():
    a = sys.argv[1:]
    if os.geteuid() != 0:
        raise SystemExit("must run as root")
    if a[:1] == ["install"] and len(a) == 2:
        cmd_install(a[1])
    elif a[:1] == ["adopt"] and len(a) == 2:
        cmd_adopt(a[1])
    elif a[:1] == ["remove"] and len(a) == 2:
        cmd_remove(a[1])
    elif a == ["restore"]:
        cmd_restore()
    elif a == ["status"]:
        print(json.dumps(load_state()))
    else:
        raise SystemExit(__doc__)


if __name__ == "__main__":
    main()
