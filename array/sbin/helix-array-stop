#!/bin/bash
# helix-array-stop — Stop the Helix OS array.
# Unmounts mergerfs user share, then data and parity drives.

set -euo pipefail
source "$(dirname "$0")/helix-array-lib.sh"

[[ $EUID -eq 0 ]] || { echo "Must run as root"; exit 1; }

[ -f "$ARRAY_STATE" ] && [ "$(cat "$ARRAY_STATE")" = "stopped" ] && {
    helix_log "Array is already stopped."
    exit 0
}

helix_log "Stopping array..."
load_disk_config

ERRORS=0

# ── VMs first: they use the drives and the user share ─────────────────────────
[ -x "$(dirname "$0")/helix-vm-stop" ] && "$(dirname "$0")/helix-vm-stop" || true

# ── Stop things that use the drives ───────────────────────────────────────────
systemctl stop docker.socket docker nfs-server smbd nmbd 2>/dev/null || true

# ── Stop mergerfs first ───────────────────────────────────────────────────────
if mountpoint -q "$USER_SHARE"; then
    if ! umount "$USER_SHARE" 2>/dev/null; then
        # Find what has the mount open
        USERS=$(fuser -m "$USER_SHARE" 2>/dev/null || true)
        helix_err "Cannot unmount $USER_SHARE — in use by: ${USERS:-unknown}"
        helix_err "Kill processes using the share first, then retry."
        exit 1
    fi
    helix_log "mergerfs stopped: $USER_SHARE unmounted"
else
    helix_log "mergerfs not mounted at $USER_SHARE"
fi

# ── Unmount data drives ───────────────────────────────────────────────────────
for i in "${!DATA_DISKS[@]}"; do
    mnt="${DATA_MNTS[$i]}"
    name="${DATA_DISKS[$i]}"
    if mountpoint -q "$mnt"; then
        if umount "$mnt" 2>/dev/null; then
            helix_log "Unmounted $name: $mnt"
        else
            helix_err "Failed to unmount $name: $mnt"
            ERRORS=$((ERRORS+1))
        fi
    fi
done

# ── Unmount cache drives ──────────────────────────────────────────────────────
for i in "${!CACHE_DISKS[@]}"; do
    mnt="${CACHE_MNTS[$i]}"
    if mountpoint -q "$mnt"; then
        umount "$mnt" 2>/dev/null && helix_log "Unmounted ${CACHE_DISKS[$i]}: $mnt" \
            || { helix_err "Failed to unmount ${CACHE_DISKS[$i]}: $mnt"; ERRORS=$((ERRORS+1)); }
    fi
done

# ── Unmount parity drives ─────────────────────────────────────────────────────
idx=1
for dev in "${PARITY_DEVS[@]}"; do
    mnt="$MNTBASE/parity$idx"
    if mountpoint -q "$mnt" 2>/dev/null; then
        umount "$mnt" 2>/dev/null && helix_log "Unmounted parity$idx: $mnt"
    fi
    idx=$((idx+1))
done

if [ $ERRORS -gt 0 ]; then
    helix_err "$ERRORS drive(s) failed to unmount cleanly."
    exit 1
fi

echo "stopped" > "$ARRAY_STATE"
date -Iseconds >> "$ARRAY_STATE"
helix_log "Array stopped."
