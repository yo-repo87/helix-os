{
  "name": "radarr",
  "title": "Radarr",
  "description": "Movie management — automatic downloading and organisation.",
  "category": "*arr",
  "icon": "radarr",
  "port": 7878,
  "vars": [
    {"key": "CONFIG_PATH",    "label": "Config path",    "default": "/mnt/user/appdata/radarr"},
    {"key": "MEDIA_PATH",     "label": "Movies path",    "default": "/mnt/user/media/movies"},
    {"key": "DOWNLOADS_PATH", "label": "Downloads path", "default": "/mnt/user/downloads"},
    {"key": "PUID",           "label": "User ID",        "default": "1000"},
    {"key": "PGID",           "label": "Group ID",       "default": "1000"}
  ],
  "compose": {
    "services": {
      "radarr": {
        "image": "linuxserver/radarr:latest",
        "container_name": "radarr",
        "ports": ["7878:7878"],
        "volumes": [
          "{{CONFIG_PATH}}:/config",
          "{{MEDIA_PATH}}:/movies",
          "{{DOWNLOADS_PATH}}:/downloads"
        ],
        "restart": "unless-stopped",
        "environment": {
          "PUID": "{{PUID}}",
          "PGID": "{{PGID}}",
          "TZ": "UTC"
        }
      }
    }
  }
}
