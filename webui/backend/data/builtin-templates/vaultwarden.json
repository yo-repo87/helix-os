{
  "name": "vaultwarden",
  "title": "Vaultwarden",
  "description": "Unofficial Bitwarden-compatible password manager server.",
  "category": "Security",
  "icon": "lock",
  "port": 8810,
  "vars": [
    {"key": "CONFIG_PATH",  "label": "Data path",   "default": "/mnt/user/appdata/vaultwarden"},
    {"key": "WEBUI_PORT",   "label": "Web UI port", "default": "8810"},
    {"key": "ADMIN_TOKEN",  "label": "Admin token (leave blank to disable admin panel)", "default": ""},
    {"key": "DOMAIN",       "label": "Public URL (e.g. https://vault.home.local)", "default": ""}
  ],
  "compose": {
    "services": {
      "vaultwarden": {
        "image": "vaultwarden/server:latest",
        "container_name": "vaultwarden",
        "ports": ["{{WEBUI_PORT}}:80"],
        "volumes": [
          "{{CONFIG_PATH}}:/data"
        ],
        "restart": "unless-stopped",
        "environment": {
          "ADMIN_TOKEN": "{{ADMIN_TOKEN}}",
          "DOMAIN": "{{DOMAIN}}",
          "SIGNUPS_ALLOWED": "true"
        }
      }
    }
  }
}
