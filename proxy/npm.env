# Versions built into the image for Nginx Proxy Manager (CLAUDE.md §54). Sourced by install-npm.sh.
# Bump together and re-run proxy/test/test-npm.sh. Node and certbot follow NPM's own base image
# (nginxproxymanager/nginx-full:certbot-node: node v26.13.1, certbot 5.10.0, openresty 1.31.8.1).
NPM_VERSION=2.17.0
NPM_SHA256=c40ff759512cd22b03241330de926692f024de738542d467c5a390f58de1db50
NODE_VERSION=26.13.1
YARN_VERSION=1.22.22
CERTBOT_VERSION=5.10.0
# DNS-challenge plugins installed into /opt/certbot at build time (the root filesystem is RAM, so a
# plugin NPM pip-installs at runtime is gone after a reboot). Names are keys of NPM's
# backend/certbot/dns-plugins.json; the version pins come from that file.
# They must resolve together in one venv. Left to NPM's install-on-first-use (phase 4 keeps such
# plugins across reboots): powerdns (~0.2.1 conflicts with the rest) and google (+125 MB of Google
# API client for one provider). Measured 2026-11-17: certbot 55 MB, cloudflare +119 MB (its SDK),
# route53 +31 MB, ovh +13 MB, the others 0-6 MB each.
CERTBOT_DNS_PLUGINS="cloudflare route53 digitalocean ovh duckdns porkbun namecheap gandi linode hetzner godaddy ionos desec dnsimple rfc2136 azure"
# Plugins NOT in the venv but whose wheels are built at image-build time (compiler present) and
# shipped in /opt/npm/certbot-wheelhouse, so helix-npm-certbot-plugins installs them OFFLINE at the
# first boot that a cert needs them (CLAUDE.md §54.4). powerdns has no PyPI wheel (sdist only), so a
# runtime-only download could never build it on the compiler-less OS. google is here to keep its
# 125 MB out of the base venv but still available offline.
CERTBOT_DNS_WHEELHOUSE="powerdns google"
# Port the NPM API listens on, loopback only (upstream: 3000 on every interface, which clashes
# with containers that publish 3000 and would expose the API on the LAN).
NPM_BACKEND_PORT=3781
NPM_ADMIN_PORT=81
