# Helix OS — full NAS stack (installed on top of packages-base.list)

# ── Array / storage ───────────────────────────────────────────────────────────
mergerfs
snapraid
# Note: ZFS requires contrib repos; skipped for standard bookworm
# (snapraid built from source if not in repo — see hooks/03-snapraid.sh)

# ── File sharing ──────────────────────────────────────────────────────────────
samba
nfs-kernel-server
avahi-daemon
avahi-utils

# ── Docker ───────────────────────────────────────────────────────────────────
docker.io
docker-compose

# ── Web UI stack ──────────────────────────────────────────────────────────────
openresty
php8.2-fpm
php8.2-cli

# ── VPN ───────────────────────────────────────────────────────────────────────
wireguard
wireguard-tools

# ── UPS monitoring ────────────────────────────────────────────────────────────
apcupsd
# nut - broken dependencies in bookworm

# ── Notifications ─────────────────────────────────────────────────────────────
# (handled by our Python daemon — no extra packages needed)

# ── Scheduler ────────────────────────────────────────────────────────────────
cron

# ── Monitoring ───────────────────────────────────────────────────────────────
prometheus-node-exporter
