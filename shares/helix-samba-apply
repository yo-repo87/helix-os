#!/bin/bash
# helix-samba-apply — Generate /etc/samba/smb.conf from Helix OS config and reload.
# Reads: /boot/config/shares.cfg, /boot/config/ident.cfg, /boot/config/samba.cfg
# Called by: helix-shares-apply, the web UI API, or directly after editing config.

set -euo pipefail

HELIX_CONFIG="${HELIX_CONFIG:-/boot/config}"
SHARES_CFG="$HELIX_CONFIG/shares.cfg"
IDENT_CFG="$HELIX_CONFIG/ident.cfg"
SAMBA_CFG="$HELIX_CONFIG/samba.cfg"
OUT="/etc/samba/smb.conf"
USER_SHARE="${USER_SHARE:-/mnt/user}"
DRY_RUN="${1:-}"  # pass --dry-run to print without writing

# ── Parse INI helpers ─────────────────────────────────────────────────────────
cfg_get() { awk -F= -v sec="[$1]" -v k="$2" '
    /^\[/{ in_s=($0==sec) } in_s && $1~/^[[:space:]]*'"$2"'[[:space:]]*$/{
        gsub(/^[[:space:]]+|[[:space:]]+$/, "", $2); print $2; exit}' "$3" 2>/dev/null; }

cfg_sections() { grep -oP '(?<=^\[)[^\]]+' "$1" 2>/dev/null; }

# ── Read identity ─────────────────────────────────────────────────────────────
HOSTNAME=$(cfg_get "identity" "NAME" "$IDENT_CFG" 2>/dev/null || true)
HOSTNAME="${HOSTNAME:-$(hostname -s 2>/dev/null || echo "Tower")}"
WORKGROUP=$(cfg_get "samba" "WORKGROUP" "$SAMBA_CFG" 2>/dev/null || true)
WORKGROUP="${WORKGROUP:-WORKGROUP}"
DESCRIPTION=$(cfg_get "samba" "DESCRIPTION" "$SAMBA_CFG" 2>/dev/null || true)
DESCRIPTION="${DESCRIPTION:-Helix OS NAS}"
MIN_PROTO=$(cfg_get "samba" "MIN_PROTOCOL" "$SAMBA_CFG" 2>/dev/null || true)
MIN_PROTO="${MIN_PROTO:-SMB2}"

# ── Build smb.conf ────────────────────────────────────────────────────────────
generate() {
cat <<EOF
# /etc/samba/smb.conf
# Auto-generated by helix-samba-apply — do not edit manually.
# Source: $SHARES_CFG
# Regenerate: helix-samba-apply

[global]
   workgroup = $WORKGROUP
   server string = $DESCRIPTION
   netbios name = $HOSTNAME
   security = user
   map to guest = Bad User
   guest account = nobody
   min protocol = $MIN_PROTO
   server min protocol = $MIN_PROTO

   # Performance
   use sendfile = yes
   aio read size = 16384
   aio write size = 16384
   socket options = TCP_NODELAY IPTOS_LOWDELAY SO_RCVBUF=131072 SO_SNDBUF=131072

   # macOS time machine / Bonjour compatibility
   fruit:metadata = stream
   fruit:model = MacSamba
   vfs objects = fruit streams_xattr

   # Logging
   log level = 1
   log file = /var/log/samba/log.%m
   max log size = 1000

EOF

# ── Share sections ────────────────────────────────────────────────────────────
while IFS= read -r section; do
    [[ "$section" == "sharedefaults" ]] && continue

    smb=$(cfg_get "$section" "smb" "$SHARES_CFG")
    [[ "$smb" == "yes" ]] || continue

    comment=$(cfg_get "$section" "comment"    "$SHARES_CFG")
    sec=$(cfg_get     "$section" "smb_security" "$SHARES_CFG")
    sec="${sec:-public}"
    path="$USER_SHARE/$section"

    cat <<EOF
[$section]
   comment = ${comment:-$section}
   path = $path
   create mask = 0664
   directory mask = 0775
   force create mode = 0664
   force directory mode = 0775
EOF

    # One service identity for all protocols (like Unraid's nobody:users): guests
    # act as the helix user so files written over SMB, NFS and the web file manager
    # can all be changed by each other. Without this, guests map to 'nobody', who
    # cannot write the helix-owned share directory.
    HAVE_HELIX=false; id helix >/dev/null 2>&1 && HAVE_HELIX=true

    if [[ "$sec" == "public" ]]; then
        echo "   public = yes"
        echo "   writable = yes"
        echo "   guest ok = yes"
        $HAVE_HELIX && { echo "   force user = helix"; echo "   force group = helix"; }
    elif [[ "$sec" == "private" ]]; then
        echo "   public = no"
        echo "   writable = yes"
        echo "   valid users = @sambashare"
        $HAVE_HELIX && echo "   force group = helix"
    else
        echo "   public = no"
        echo "   writable = yes"
        echo "   valid users = $sec"
        $HAVE_HELIX && echo "   force group = helix"
    fi

    # Recycle bin (enabled by default for SMB shares)
    recycled=$(cfg_get "$section" "recycle_bin" "$SHARES_CFG")
    if [[ "${recycled:-yes}" == "yes" ]]; then
        echo "   vfs objects = fruit streams_xattr recycle"
        echo "   recycle:repository = .Recycle.Bin"
        echo "   recycle:keeptree = yes"
        echo "   recycle:versions = yes"
    fi

    echo ""
done < <(cfg_sections "$SHARES_CFG")
}

# ── Output ────────────────────────────────────────────────────────────────────
if [[ "$DRY_RUN" == "--dry-run" ]]; then
    echo "=== smb.conf preview (not written) ===" && generate
    exit 0
fi

[[ -d /etc/samba ]] || { echo "Samba not installed. Run: apt install samba"; exit 1; }

generate > "$OUT"
echo "Written: $OUT"

# Reload samba if running
if systemctl is-active --quiet smbd 2>/dev/null; then
    smbcontrol all reload-config 2>/dev/null && echo "Samba reloaded." \
        || systemctl reload smbd && echo "smbd reloaded."
elif grep -q '^smb=yes' "$SHARES_CFG" 2>/dev/null; then
    systemctl start smbd nmbd 2>/dev/null && echo "smbd started." \
        || echo "WARN: could not start smbd (check: journalctl -u smbd)"
else
    echo "No SMB shares defined — smbd left stopped."
fi
