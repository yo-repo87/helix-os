#!/bin/bash
# helix-shares-apply — Apply all share protocols at once.
# Runs helix-samba-apply and helix-nfs-apply, then ensures share
# directories exist on the user share mount.
# Called after any share config change.

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
HELIX_CONFIG="${HELIX_CONFIG:-/boot/config}"
USER_SHARE="${USER_SHARE:-/mnt/user}"
SHARES_CFG="$HELIX_CONFIG/shares.cfg"

cfg_sections() { grep -oP '(?<=^\[)[^\]]+' "$1" 2>/dev/null; }
cfg_get() { awk -F= -v sec="[$1]" -v k="$2" '
    /^\[/{ in_s=($0==sec) } in_s && $1~/^[[:space:]]*'"$2"'[[:space:]]*$/{
        gsub(/^[[:space:]]+|[[:space:]]+$/, "", $2); print $2; exit}' "$3" 2>/dev/null; }

echo "==> Applying share configuration..."

# ── Ensure share directories exist ───────────────────────────────────────────
if mountpoint -q "$USER_SHARE" 2>/dev/null; then
    while IFS= read -r section; do
        [[ "$section" == "sharedefaults" ]] && continue
        path="$USER_SHARE/$section"
        mkdir -p "$path"
        chmod 0775 "$path"
    done < <(cfg_sections "$SHARES_CFG")
    echo "    Share directories: OK"
else
    echo "    WARN: $USER_SHARE not mounted — skipping directory creation."
fi

# ── Apply Samba ───────────────────────────────────────────────────────────────
echo "    Applying Samba..."
HELIX_CONFIG="$HELIX_CONFIG" USER_SHARE="$USER_SHARE" bash "$SCRIPT_DIR/helix-samba-apply" || \
    echo "    SKIP: Samba not installed."

# ── Apply NFS ─────────────────────────────────────────────────────────────────
echo "    Applying NFS..."
HELIX_CONFIG="$HELIX_CONFIG" USER_SHARE="$USER_SHARE" bash "$SCRIPT_DIR/helix-nfs-apply" || \
    echo "    SKIP: NFS not installed."

echo "==> Share configuration applied."
