#!/bin/bash
# helix-array-start — Start the Helix OS array.
# Mounts all data disks, starts mergerfs user share, generates snapraid.conf.
# Equivalent to Unraid's "Start Array" button.

set -euo pipefail
source "$(dirname "$0")/helix-array-lib.sh"

[[ $EUID -eq 0 ]] || { echo "Must run as root"; exit 1; }

# Check if already started
[ -f "$ARRAY_STATE" ] && [ "$(cat "$ARRAY_STATE")" = "started" ] && {
    helix_log "Array is already started."
    exit 0
}

helix_log "Starting array..."
load_disk_config
ensure_dirs

# ── Import ZFS pools ──────────────────────────────────────────────────────────
# Only the pools imported or created from the ZFS page (HELIX_CONFIG/zfs/pools.json), never
# every pool found on the disks: a foreign pool is imported when the user asks for it.
# -f is needed every boot: the root is in RAM, so the hostid differs from the one the pool
# was last imported under.
zfs_import_recorded

# ── Mount parity drives ───────────────────────────────────────────────────────
# SnapRAID keeps its parity FILE on a mounted file system (/mnt/parityN), so a parity disk needs
# one like any other disk. A new parity disk shows up on Main as unmountable; Format creates it.
idx=1
for dev in "${PARITY_DEVS[@]}"; do
    mnt="$MNTBASE/parity$idx"
    if [ ! -b "$dev" ]; then
        helix_log "WARN: Parity device $dev not found — continuing without it."
        idx=$((idx+1)); continue
    fi
    fsdev=$(fs_device "$dev"); fstype=$(fs_type "$dev")
    if [ -n "$fstype" ]; then
        mountpoint -q "$mnt" || mount -t "$fstype" "$fsdev" "$mnt"
        helix_log "Mounted parity$idx: $fsdev → $mnt ($fstype)"
    else
        # Not "raw": there is nothing sensible to point SnapRAID at. Leave it unmounted; Main offers Format,
        # and Parity Sync stays disabled until the disk has a file system.
        helix_log "WARN: Parity$idx: $dev has no file system. Format it from Main before running Parity Sync."
    fi
    idx=$((idx+1))
done

# ── Mount data drives ─────────────────────────────────────────────────────────
MOUNTED_MNTS=()
for i in "${!DATA_DISKS[@]}"; do
    dev="${DATA_DEVS[$i]}"
    mnt="${DATA_MNTS[$i]}"
    name="${DATA_DISKS[$i]}"

    if [ ! -b "$dev" ]; then
        helix_log "WARN: $name device $dev not found — skipping."
        continue
    fi

    if mountpoint -q "$mnt"; then
        helix_log "$name already mounted at $mnt"
    else
        fsdev=$(fs_device "$dev"); fstype=$(fs_type "$dev")
        [ -n "$fstype" ] || { helix_log "WARN: $name ($dev) has no filesystem — skipping. Format it first."; continue; }
        mount -t "$fstype" -o defaults,noatime "$fsdev" "$mnt"
        helix_log "Mounted $name: $fsdev → $mnt ($fstype)"
    fi
    MOUNTED_MNTS+=("$mnt")
done

# ── Generate SnapRAID config ──────────────────────────────────────────────────
generate_snapraid_conf
helix_log "SnapRAID config written to $SNAPRAID_CONF"

# ── Start mergerfs (user share) ───────────────────────────────────────────────
# A brand-new disk has no file system yet. The array still comes online so Main
# can show it as unmountable and Format can create the file system. mergerfs
# needs at least one mounted data disk, so it waits until one exists.
if [ ${#MOUNTED_MNTS[@]} -eq 0 ]; then
    helix_log "WARN: No data drive has a filesystem. The array stays online so Main can format the unmountable disks."
elif mountpoint -q "$USER_SHARE"; then
    helix_log "mergerfs already mounted at $USER_SHARE"
else
    BRANCHES=$(IFS=:; echo "${MOUNTED_MNTS[*]}")
    if start_user_share "$BRANCHES"; then
        helix_log "mergerfs started: $BRANCHES → $USER_SHARE"
    else
        helix_err "mergerfs did not mount $USER_SHARE (branches $BRANCHES)"
    fi
fi

# ── Mount cache drives ────────────────────────────────────────────────────────
# Cache/pool drives are mounted separately (not mergerfs branches). Shares set to
# "use cache" write here first; helix-mover later moves data to the array.
for i in "${!CACHE_DISKS[@]}"; do
    dev="${CACHE_DEVS[$i]}"
    mnt="${CACHE_MNTS[$i]}"
    name="${CACHE_DISKS[$i]}"
    if [ ! -b "$dev" ]; then
        helix_log "WARN: cache $name device $dev not found — skipping."
        continue
    fi
    if mountpoint -q "$mnt"; then
        helix_log "cache $name already mounted at $mnt"
    else
        fsdev=$(fs_device "$dev"); fstype=$(fs_type "$dev")
        [ -n "$fstype" ] || { helix_log "WARN: cache $name ($dev) has no filesystem — skipping. Format it first."; continue; }
        mount -t "$fstype" -o defaults,noatime "$fsdev" "$mnt"
        helix_log "Mounted cache $name: $fsdev → $mnt ($fstype)"
    fi
done

# ── Mount-root ownership ──────────────────────────────────────────────────────
# A freshly formatted filesystem's root is root:root 0755, so the unprivileged
# web backend (user helix) could not create shares or upload files under
# /mnt/user. Hand the top level of each mount to helix (non-recursive).
if id helix >/dev/null 2>&1; then
    for m in "${MOUNTED_MNTS[@]}" "${CACHE_MNTS[@]}"; do
        mountpoint -q "$m" || continue
        if [ "$(stat -c %U "$m")" = "root" ]; then
            chown helix:helix "$m" && chmod 0775 "$m"
        fi
    done
fi

set +e   # container/share services must never be able to fail the array start
# ── Docker (data-root on persistent storage) ──────────────────────────────────
# Never in the RAM root. The disk that already holds Docker's data wins (otherwise reordering
# or reassigning disks starts Docker empty and every container seems gone); for a new setup a
# cache drive, else the first data disk. These are real filesystems (overlay2 does not work on
# the mergerfs FUSE user share).
if command -v dockerd >/dev/null 2>&1; then
    droot=""
    dbase=$(system_disk docker)
    [ -n "$dbase" ] && droot="$dbase/system/docker"
    if [ -z "$droot" ]; then
        helix_log "WARN: Docker left stopped — no formatted disk for its data."
    else
        mkdir -p "$droot" /etc/docker
        # Merge, never replace: the NVIDIA add-in adds a "runtimes" entry here and an array stop/start in the same
        # boot must keep it. An unreadable file is replaced (and kept as .bad) rather than blocking Docker.
        python3 - "$droot" <<'PYEOF' || printf '{\n  "data-root": "%s"\n}\n' "$droot" > /etc/docker/daemon.json
import json, os, sys
p = "/etc/docker/daemon.json"
cfg = {}
if os.path.exists(p):
    try:
        cfg = json.load(open(p))
        if not isinstance(cfg, dict):
            raise ValueError("not an object")
    except ValueError:
        os.replace(p, p + ".bad")
        cfg = {}
cfg["data-root"] = sys.argv[1]
tmp = p + ".tmp"
with open(tmp, "w") as f:
    json.dump(cfg, f, indent=2)
    f.write("\n")
os.replace(tmp, p)
PYEOF
        if systemctl start docker 2>/dev/null; then
            helix_log "Docker started (data-root $droot)"
        else
            helix_log "WARN: docker failed to start (journalctl -u docker)"
        fi
    fi
fi

# ── Add-ins (NVIDIA driver etc.): re-install from the copy kept on the array, in the background ──
# The root filesystem is RAM, so they vanish at every boot. DKMS compiles can take minutes.
if [ -x /usr/local/sbin/helix-addin ]; then
    # In its own systemd unit: array start runs from the backend, and a child left in the backend's cgroup is killed by
    # any backend restart (OTA, crash, dev push) halfway through a DKMS build.
    if command -v systemd-run >/dev/null 2>&1 && [ -d /run/systemd/system ]; then
        systemctl reset-failed helix-addin-restore.service 2>/dev/null
        systemd-run --unit=helix-addin-restore --collect --setenv=HELIX_CONFIG="$HELIX_CONFIG" \
            /bin/sh -c 'exec python3 /usr/local/sbin/helix-addin restore >/var/log/helix-addin-restore.log 2>&1' >/dev/null 2>&1 \
            || helix_log "WARN: could not start the add-in restore"
    else
        ( HELIX_CONFIG="$HELIX_CONFIG" nohup python3 /usr/local/sbin/helix-addin restore >/var/log/helix-addin-restore.log 2>&1 & )
    fi
fi

# ── Share services (SMB / NFS) ────────────────────────────────────────────────
if [ -x /usr/local/sbin/helix-shares-apply ]; then
    HELIX_CONFIG="$HELIX_CONFIG" /usr/local/sbin/helix-shares-apply >/dev/null 2>&1 \
        && helix_log "Share services applied" || helix_log "WARN: helix-shares-apply reported errors"
fi

# ── VM Manager (libvirt, state on persistent storage) — only when enabled ───────
if [ -x "$(dirname "$0")/helix-vm-start" ]; then
    "$(dirname "$0")/helix-vm-start" --from-array-start || helix_log "WARN: VM Manager did not start (see /var/log/helix-array.log)"
fi

# ── Monitoring (Checkmk) — only when it has been enabled; after Docker and VMs so they are all seen ──
if [ -x /usr/local/sbin/helix-monitor ]; then
    # In the background and in its own unit: it waits up to 5 min for Docker, which must not hold up the array
    # start, and a backend restart must not kill it (array start runs from the backend).
    if command -v systemd-run >/dev/null 2>&1 && [ -d /run/systemd/system ]; then
        systemctl reset-failed helix-monitor-start.service 2>/dev/null
        systemd-run --unit=helix-monitor-start --collect \
            --setenv=HELIX_CONFIG="$HELIX_CONFIG" --setenv=STATE_DIR="$STATE_DIR" \
            /usr/bin/python3 /usr/local/sbin/helix-monitor start >/dev/null 2>&1 \
            || helix_log "WARN: could not start monitoring (helix-monitor start)"
    else
        HELIX_CONFIG="$HELIX_CONFIG" STATE_DIR="$STATE_DIR" python3 /usr/local/sbin/helix-monitor start \
            || helix_log "WARN: monitoring did not start (helix-monitor start)"
    fi
fi

set -e

# ── Record state ──────────────────────────────────────────────────────────────
echo "started" > "$ARRAY_STATE"
date -Iseconds >> "$ARRAY_STATE"

helix_log "Array started. ${#MOUNTED_MNTS[@]} data drive(s) online."
helix_log "User share: $USER_SHARE"
helix_log "Run 'helix-parity-check' to sync parity after adding new files."
