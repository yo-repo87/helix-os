{
  "name": "jellyfin-plex-minimal",
  "title": "Jellyfin Plex - Minimal",
  "description": "Jellyfin Plex Enhancement with minimal configuration. No external volumes, perfect for testing or single-user deployments.",
  "category": "Media",
  "icon": "https://raw.githubusercontent.com/jellyfin/jellyfin-ux/master/branding/SVG/icon-transparent.svg",
  "port": 3000,
  "vars": [
    {
      "key": "WEB_PORT",
      "label": "Web port",
      "default": "3000",
      "type": "port"
    }
  ],
  "compose": {
    "services": {
      "jellyfin-plex": {
        "image": "ghcr.io/yo-repo87/jellyfin-plex-enhancement:latest",
        "container_name": "jellyfin-plex-minimal",
        "restart": "unless-stopped",
        "ports": ["$WEB_PORT:3000"],
        "environment": {"NODE_ENV": "production"},
        "healthcheck": {
          "test": ["CMD", "wget", "--quiet", "--tries=1", "--spider", "http://localhost:3000/"],
          "interval": 30,
          "timeout": 3,
          "retries": 3,
          "start_period": 10
        }
      }
    }
  }
}
