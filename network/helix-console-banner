#!/bin/sh
# helix-console-banner — write /etc/issue with the current IP address(es) and
# the web UI URL, shown on the console *before* the login prompt.
#
# The console banner is how you find the box on your LAN.
# Run at boot (after the network is up) by helix-console-banner.service, and
# again whenever addresses change.
set -eu

ISSUE=/etc/issue
HOST="$(hostname 2>/dev/null || echo helix)"
VER="$(cat /etc/helix-version 2>/dev/null || echo '')"

# Global-scope IPv4 addresses on real links (skip loopback/virtual/container).
HELIX_CONFIG="${HELIX_CONFIG:-/boot/config}"
USER_SHARE="${USER_SHARE:-/mnt/user}"
SHARES_CFG="$HELIX_CONFIG/shares.cfg"

ips=$(ip -o -4 addr show scope global 2>/dev/null \
  | awk '$2 !~ /^(lo|docker|veth|br-|virbr|tap|wg|kube|cni)/ {split($4,a,"/"); print $2" "a[1]}')

{
  printf '\n'
  if [ -n "$VER" ]; then printf '  Helix OS %s  (%s)\n' "$VER" "$HOST"
  else                    printf '  Helix OS  (%s)\n' "$HOST"; fi
  printf '  ----------------------------------------------------------\n'
  if [ -n "$ips" ]; then
    printf '  Web UI (open in a browser):\n'
    echo "$ips" | while read -r ifn ip; do
      printf '      http://%s/         [%s]\n' "$ip" "$ifn"
      printf '      https://%s/        [%s, self-signed cert]\n' "$ip" "$ifn"
    done
  else
    printf '  Web UI:  no network link yet — check cabling / DHCP\n'
  fi
  # File shares: only while the array is started (the shares do not exist before that).
  if [ -f "$SHARES_CFG" ] && mountpoint -q "$USER_SHARE" 2>/dev/null; then
    ip1=$(echo "$ips" | awk 'NR==1{print $2}')
    lines=$(awk -v ip="${ip1:-$HOST}" '
      function flush() { if (sec != "" && sec != "sharedefaults") {
          if (smb == "yes") printf "      SMB  \\\\%s\\%s   (%s)\n", ip, sec, (secu == "public" || secu == "" ? "guest access, no password" : "needs a user name and password")
          if (nfs == "yes") printf "      NFS  %s:%s/%s\n", ip, us, sec } }
      /^\[/ { flush(); sec=$0; gsub(/[\[\]]/, "", sec); smb=""; nfs=""; secu=""; next }
      /^smb=/ { sub(/^smb=/, ""); smb=$0 }
      /^nfs=/ { sub(/^nfs=/, ""); nfs=$0 }
      /^smb_security=/ { sub(/^smb_security=/, ""); secu=$0 }
      END { flush() }' us="$USER_SHARE" "$SHARES_CFG")
    if [ -n "$lines" ]; then
      printf '\n  File shares:\n%s\n' "$lines"
    fi
  fi
  printf '\n'
  printf '  SSH:     root, after setting a password with passwd\n'
  printf '  Login:   root (blank password until you set one)\n'
  printf '\n'
} > "$ISSUE"

cp "$ISSUE" /etc/issue.net 2>/dev/null || true

# Redraw tty1 so the address appears on the already-displayed prompt. Nobody is
# logged in at boot, so a restart is safe. Pass --no-restart to skip.
if [ "${1:-}" != "--no-restart" ]; then
  # Never restart the getty under someone who is logged in on tty1.
  if ! who 2>/dev/null | awk '{print $2}' | grep -qx tty1; then
    systemctl try-restart getty@tty1.service 2>/dev/null || true
  fi
fi
