#!/usr/bin/env python3
"""helix-firewall — apply the Helix firewall (nftables table `inet helix`). Root only.

    helix-firewall boot                     apply the saved config at boot (first run: learn mode)
    helix-firewall apply [--revert-after N] apply the pending config ($STATE_DIR/firewall.pending.json);
                                            with N, it is undone after N seconds unless confirmed
    helix-firewall confirm                  keep the pending config (saved to $HELIX_CONFIG/firewall.json)
    helix-firewall revert                   go back to the saved config
    helix-firewall off                      turn the firewall off now and in the saved config (console escape hatch)
    helix-firewall status                   JSON: active mode, pending change, revert deadline
    helix-firewall reapply                  rebuild from the current config (container IPs, lists, bans)
    helix-firewall ban <ip> <minutes> <why> / unban <ip>
    helix-firewall update-lists             download the enabled blocklists and country lists (daily timer)
    helix-firewall watch                    daemon: ban after repeated failed logins (SSH, web UI, FTP, SMB);
                                            follow Docker so per-container outbound rules track container IPs

The ruleset is generated by the backend's services/firewall.py, so the boot path and the web UI build the same
thing. Each change is one atomic `nft -f` transaction, checked first with `nft -c`.
"""
import json
import os
import subprocess
import sys
import time

BACKEND = os.environ.get("HELIX_BACKEND", "/opt/helix/backend")
sys.path.insert(0, BACKEND)
from config import HELIX_CONFIG, STATE_DIR  # noqa: E402
from services import firewall as fw  # noqa: E402

SAVED = os.path.join(HELIX_CONFIG, "firewall.json")
PENDING = os.path.join(STATE_DIR, "firewall.pending.json")
META = os.path.join(STATE_DIR, "firewall.pending-meta.json")
ACTIVE = os.path.join(STATE_DIR, "firewall.active.json")
REVERT_UNIT = "helix-firewall-revert"
BANS = os.path.join(HELIX_CONFIG, "firewall-bans.json")
LISTS_DIR = os.path.join(HELIX_CONFIG, "firewall-lists")
GEO_DIR = os.path.join(HELIX_CONFIG, "firewall-geo")
LISTS_STATUS = os.path.join(STATE_DIR, "firewall-lists-status.json")
NFT = os.environ.get("HELIX_NFT", "nft")


def sh(cmd, **kw):
    """subprocess.run that never raises: a missing tool (no systemd in a rescue shell) is just a failed call."""
    try:
        return subprocess.run(cmd, capture_output=True, text=True, **kw)
    except OSError as e:
        return subprocess.CompletedProcess(cmd, 127, "", str(e))


def log(msg):
    print(f"[helix-firewall] {msg}", flush=True)


def read(path):
    try:
        with open(path) as f:
            return json.load(f)
    except (OSError, ValueError):
        return None


def write(path, data):
    tmp = path + ".tmp"
    with open(tmp, "w") as f:
        f.write(fw.dumps(data))
    os.replace(tmp, path)
    try:
        os.chown(path, *_helix_ids())
    except (OSError, KeyError):
        pass


def _helix_ids():
    import pwd
    p = pwd.getpwnam("helix")
    return p.pw_uid, p.pw_gid


# ── runtime data for the generator ──

def load_bans() -> dict:
    b = read(BANS)
    return b if isinstance(b, dict) else {}


def save_bans(b: dict) -> None:
    now = time.time()
    b = {ip: v for ip, v in b.items() if isinstance(v, dict) and v.get("until", 0) > now}
    os.makedirs(os.path.dirname(BANS), exist_ok=True)
    tmp = BANS + ".tmp"
    with open(tmp, "w") as f:
        json.dump(b, f, indent=1)
    os.replace(tmp, BANS)


def _read_lines(path) -> list[str]:
    try:
        with open(path) as f:
            return [x.strip() for x in f if x.strip()]
    except OSError:
        return []


def container_ips(names) -> dict:
    """{name: [ipv4...]} for running containers (empty when Docker is down)."""
    out = {}
    for n in names:
        r = sh(["docker", "inspect", "-f", "{{range .NetworkSettings.Networks}}{{.IPAddress}} {{end}}", n], timeout=10)
        if r.returncode == 0:
            out[n] = [ip for ip in r.stdout.split() if ip]
    return out


def gather(cfg) -> dict:
    cfg = fw.clean_config(cfg)
    now = time.time()
    data = {"bans": {ip: int(v["until"] - now) for ip, v in load_bans().items()
                     if isinstance(v, dict) and v.get("until", 0) > now}}
    data["lists"] = {b["id"]: _read_lines(os.path.join(LISTS_DIR, b["id"] + ".txt"))
                     for b in cfg["blocklists"] if b["enabled"]}
    data["geo"] = {cc: _read_lines(os.path.join(GEO_DIR, cc + ".txt")) for cc in cfg["geo"]["countries"]}
    eg = {}
    if cfg["mode"] == "enforce" and cfg["egress"]:
        ips = container_ips(cfg["egress"])
        for name, pol in cfg["egress"].items():
            eg.setdefault(pol, []).extend(ips.get(name, []))
    data["egress_ips"] = eg
    return data


def nft_apply(cfg) -> None:
    script = fw.generate(cfg, gather(cfg))
    if not script:                                   # mode off
        sh([NFT, "delete", "table", "inet", "helix"])
    else:
        chk = sh([NFT, "-c", "-f", "-"], input=script)
        if chk.returncode != 0:
            raise SystemExit("nft rejected the ruleset (nothing changed): " + (chk.stderr.strip() or chk.stdout.strip()))
        r = sh([NFT, "-f", "-"], input=script)
        if r.returncode != 0:
            raise SystemExit("nft could not apply the ruleset: " + r.stderr.strip())
    with open(ACTIVE, "w") as f:
        json.dump({"mode": fw.clean_config(cfg)["mode"], "applied": int(time.time())}, f)


def cancel_revert():
    sh(["systemctl", "stop", f"{REVERT_UNIT}.timer", f"{REVERT_UNIT}.service"])
    sh(["systemctl", "reset-failed", f"{REVERT_UNIT}.timer", f"{REVERT_UNIT}.service"])


def saved_config():
    cfg = read(SAVED)
    return fw.clean_config(cfg) if cfg else None


def cmd_boot():
    cfg = saved_config()
    if cfg is None:
        # First run on this machine (user decision): learn mode. Nothing is blocked; the UI shows what would be.
        cfg = {**fw.default_config(), "mode": "learn", "learn_since": int(time.time())}
        try:
            write(SAVED, cfg)
        except OSError as e:
            log(f"could not save the first-run config ({e}); learn mode for this boot only")
    nft_apply(cfg)
    log(f"applied ({cfg['mode']}, {len(cfg['rules'])} rules)")


def cmd_apply(revert_after):
    cfg = read(PENDING)
    if cfg is None:
        raise SystemExit("no pending firewall change")
    cfg = fw.clean_config(cfg)
    cancel_revert()
    nft_apply(cfg)
    if revert_after:
        # The undo runs this same helper with the same settings (not a fixed path: dev installs and tests differ).
        env = [f"--setenv={k}={os.environ[k]}" for k in ("HELIX_CONFIG", "STATE_DIR", "HELIX_BACKEND", "HELIX_NFT")
               if os.environ.get(k)]
        r = sh(["systemd-run", f"--unit={REVERT_UNIT}", f"--on-active={int(revert_after)}",
                "--timer-property=AccuracySec=1s", *env,
                sys.executable, os.path.abspath(__file__), "revert", "--from-timer"])
        if r.returncode != 0:
            nft_apply(saved_config() or fw.default_config())       # no safety net -> do not keep it
            raise SystemExit("could not schedule the automatic undo, so the change was not kept: " + r.stderr.strip())
        with open(META, "w") as f:
            json.dump({"deadline": int(time.time()) + int(revert_after)}, f)
        log(f"applied ({cfg['mode']}); undone in {revert_after}s unless confirmed")
    else:
        _promote(cfg)
        log(f"applied and saved ({cfg['mode']})")


def _promote(cfg):
    write(SAVED, cfg)
    for p in (PENDING, META):
        try:
            os.unlink(p)
        except OSError:
            pass


def cmd_confirm():
    cfg = read(PENDING)
    if cfg is None:
        raise SystemExit("nothing to confirm (the change was already undone or saved)")
    cancel_revert()
    _promote(fw.clean_config(cfg))
    log("change kept")


def cmd_revert(from_timer=False):
    if not from_timer:            # the timer's own run must not stop its own unit
        cancel_revert()
    cfg = saved_config() or fw.default_config()
    nft_apply(cfg)
    for p in (PENDING, META):
        try:
            os.unlink(p)
        except OSError:
            pass
    log(f"reverted to the saved config ({cfg['mode']})")


def cmd_off():
    cancel_revert()
    cfg = saved_config() or fw.default_config()
    cfg["mode"] = "off"
    nft_apply(cfg)
    try:
        write(SAVED, cfg)
    except OSError as e:
        log(f"firewall is off now, but could not save that ({e}); it comes back at the next boot")
    for p in (PENDING, META):
        try:
            os.unlink(p)
        except OSError:
            pass
    log("firewall off")


def current_config():
    """What is in force now: the pending (unconfirmed) change if there is one, else the saved config."""
    p = read(PENDING)
    return fw.clean_config(p) if p else (saved_config() or fw.default_config())


def cmd_reapply():
    cfg = current_config()
    nft_apply(cfg)
    log(f"re-applied ({cfg['mode']})")


def _set_for(ip):
    return "banned4" if ":" not in ip else "banned6"


def cmd_ban(ip, minutes, why):
    if not fw._is_ip(ip):
        raise SystemExit(f"not an IP address: {ip}")
    cfg = current_config()
    if not fw.bannable(cfg, ip):
        raise SystemExit(f"{ip} is never banned (this machine, LAN/VPN, or the never-ban list)")
    secs = max(60, int(minutes) * 60)
    b = load_bans()
    b[ip] = {"until": time.time() + secs, "since": time.time(), "reason": str(why)[:120]}
    save_bans(b)
    if cfg["mode"] == "enforce" and cfg["bans"]["enabled"]:
        sh([NFT, "add", "element", "inet", "helix", _set_for(ip), "{", f"{ip} timeout {secs}s", "}"])
    log(f"banned {ip} for {secs // 60} min: {why}")


def cmd_unban(ip):
    b = load_bans()
    b.pop(ip, None)
    save_bans(b)
    sh([NFT, "delete", "element", "inet", "helix", _set_for(ip), "{", ip, "}"])
    log(f"unbanned {ip}")


def _fetch(url, limit=40_000_000) -> str:
    import urllib.request
    if not url.startswith("https://"):
        raise ValueError("only https:// lists")
    req = urllib.request.Request(url, headers={"User-Agent": "helix-firewall"})
    with urllib.request.urlopen(req, timeout=60) as r:
        body = r.read(limit + 1)
    if len(body) > limit:
        raise ValueError("list too large")
    return body.decode("utf-8", "replace")


def cmd_update_lists():
    cfg = current_config()
    exclude = cfg["lan_networks"] + fw.VPN_NETS
    status = {"started": int(time.time()), "lists": {}, "geo": {}}
    os.makedirs(LISTS_DIR, exist_ok=True)
    os.makedirs(GEO_DIR, exist_ok=True)
    for b in cfg["blocklists"]:
        if not b["enabled"]:
            continue
        try:
            nets = fw.parse_cidr_list(_fetch(b["url"]), exclude)
            with open(os.path.join(LISTS_DIR, b["id"] + ".txt"), "w") as f:
                f.write("\n".join(nets) + "\n")
            status["lists"][b["id"]] = {"ok": True, "count": len(nets), "at": int(time.time())}
        except Exception as e:                                   # noqa: BLE001 - reported to the UI
            status["lists"][b["id"]] = {"ok": False, "error": str(e)[:200], "at": int(time.time()),
                                        "count": len(_read_lines(os.path.join(LISTS_DIR, b["id"] + ".txt")))}
    for cc in cfg["geo"]["countries"]:
        nets, errs = [], []
        for tpl in fw.GEO_URLS:
            try:
                nets += fw.parse_cidr_list(_fetch(tpl.format(cc=cc.lower())), exclude)
            except Exception as e:                               # noqa: BLE001
                errs.append(str(e)[:120])
        if nets:
            with open(os.path.join(GEO_DIR, cc + ".txt"), "w") as f:
                f.write("\n".join(sorted(set(nets))) + "\n")
        status["geo"][cc] = {"ok": bool(nets), "count": len(set(nets)) or len(_read_lines(os.path.join(GEO_DIR, cc + ".txt"))),
                             "error": "; ".join(errs) if not nets else "", "at": int(time.time())}
    status["finished"] = int(time.time())
    with open(LISTS_STATUS, "w") as f:
        json.dump(status, f)
    if cfg["mode"] != "off":
        nft_apply(cfg)
    log("lists updated")


def cmd_watch():
    """Follow failed logins and Docker; ban / re-apply. Runs as a systemd service."""
    import collections
    import threading
    fails = collections.defaultdict(collections.deque)
    lock = threading.Lock()
    state = {"cfg": current_config(), "loaded": time.time()}

    def cfg():
        if time.time() - state["loaded"] > 30:
            state["cfg"], state["loaded"] = current_config(), time.time()
        return state["cfg"]

    def failure(source, ip):
        c = cfg()
        b = c["bans"]
        if c["mode"] != "enforce" or not b["enabled"] or source not in b["sources"] or not fw.bannable(c, ip):
            return
        now = time.time()
        with lock:
            q = fails[ip]
            q.append(now)
            while q and q[0] < now - b["window_min"] * 60:
                q.popleft()
            hit = len(q) >= b["max_retries"]
            if hit:
                fails.pop(ip, None)
        if hit:
            try:
                cmd_ban(ip, b["ban_min"], f"{b['max_retries']} failed {source} logins")
            except SystemExit as e:
                log(str(e))

    def follow(cmd, decide):
        while True:
            try:
                p = subprocess.Popen(cmd, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, text=True)
                for line in p.stdout:
                    decide(line)
                p.wait()
            except OSError as e:
                log(f"{cmd[0]}: {e}")
            time.sleep(15)

    def journal_line(line):
        try:
            j = json.loads(line)
        except ValueError:
            return
        msg = j.get("MESSAGE") or ""
        if not isinstance(msg, str):
            return
        src = "webui" if j.get("_SYSTEMD_UNIT") == "helix-backend.service" else "ssh"
        ip = fw.parse_auth(src, msg)
        if ip:
            failure(src, ip)

    def file_line(source):
        def go(line):
            ip = fw.parse_auth(source, line)
            if ip:
                failure(source, ip)
        return go

    pending = {"t": 0.0}

    def docker_line(line):
        if line.split(" ", 1)[-1].strip() in cfg()["egress"]:
            pending["t"] = time.time() + 2                      # debounce a burst of start/die events

    def reapplier():
        while True:
            time.sleep(1)
            if pending["t"] and time.time() >= pending["t"]:
                pending["t"] = 0
                try:
                    nft_apply(current_config())
                except SystemExit as e:
                    log(f"re-apply after a container change failed: {e}")

    threads = [
        (["journalctl", "-f", "-n", "0", "-o", "json", "_COMM=sshd", "+", "_SYSTEMD_UNIT=helix-backend.service"], journal_line),
        (["tail", "-F", "-n", "0", "/var/log/vsftpd.log"], file_line("ftp")),
        (["tail", "-F", "-n", "0", "/var/log/samba/auth.log"], file_line("smb")),
        (["docker", "events", "--filter", "type=container", "--filter", "event=start", "--filter", "event=die",
          "--format", "{{.Action}} {{.Actor.Attributes.name}}"], docker_line),
    ]
    for cmd, fn in threads:
        threading.Thread(target=follow, args=(cmd, fn), daemon=True).start()
    threading.Thread(target=reapplier, daemon=True).start()
    log("watching failed logins and container changes")
    while True:
        time.sleep(3600)
        save_bans(load_bans())                                   # drop expired entries


def cmd_status():
    table = sh([NFT, "list", "table", "inet", "helix"]).returncode == 0
    meta = read(META) or {}
    active = read(ACTIVE) or {}
    print(json.dumps({"table": table, "active_mode": active.get("mode") if table else "off",
                      "applied": active.get("applied"), "pending": os.path.exists(PENDING),
                      "deadline": meta.get("deadline")}))


def main():
    a = sys.argv[1:]
    if os.geteuid() != 0:
        raise SystemExit("must run as root")
    if a == ["boot"]:
        cmd_boot()
    elif a[:1] == ["apply"]:
        n = int(a[a.index("--revert-after") + 1]) if "--revert-after" in a else 0
        cmd_apply(n)
    elif a == ["confirm"]:
        cmd_confirm()
    elif a[:1] == ["revert"]:
        cmd_revert(from_timer="--from-timer" in a)
    elif a == ["off"]:
        cmd_off()
    elif a == ["status"]:
        cmd_status()
    elif a == ["reapply"]:
        cmd_reapply()
    elif a[:1] == ["ban"] and len(a) >= 3:
        cmd_ban(a[1], int(a[2]), " ".join(a[3:]) or "manual")
    elif a[:1] == ["unban"] and len(a) == 2:
        cmd_unban(a[1])
    elif a == ["update-lists"]:
        cmd_update_lists()
    elif a == ["watch"]:
        cmd_watch()
    else:
        raise SystemExit(__doc__)


if __name__ == "__main__":
    main()
