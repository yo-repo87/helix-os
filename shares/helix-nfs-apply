#!/bin/bash
# helix-nfs-apply — Generate /etc/exports from Helix OS config and reload.
# Reads: /boot/config/shares.cfg, /boot/config/nfs.cfg

set -euo pipefail

HELIX_CONFIG="${HELIX_CONFIG:-/boot/config}"
SHARES_CFG="$HELIX_CONFIG/shares.cfg"
NFS_CFG="$HELIX_CONFIG/nfs.cfg"
OUT="/etc/exports"
USER_SHARE="${USER_SHARE:-/mnt/user}"
DRY_RUN="${1:-}"

cfg_get() { awk -F= -v sec="[$1]" -v k="$2" '
    /^\[/{ in_s=($0==sec) } in_s && $1~/^[[:space:]]*'"$2"'[[:space:]]*$/{
        gsub(/^[[:space:]]+|[[:space:]]+$/, "", $2); print $2; exit}' "$3" 2>/dev/null; }
cfg_sections() { grep -oP '(?<=^\[)[^\]]+' "$1" 2>/dev/null; }

# Global NFS options (from nfs.cfg, with sane defaults)
NFS_NETWORK=$(cfg_get "nfs" "ALLOWED_NETWORK" "$NFS_CFG" 2>/dev/null || true)
NFS_NETWORK="${NFS_NETWORK:-192.168.0.0/16}"
NFS_OPTIONS=$(cfg_get "nfs" "OPTIONS" "$NFS_CFG" 2>/dev/null || true)
NFS_OPTIONS="${NFS_OPTIONS:-rw,sync,no_subtree_check,no_root_squash}"

generate() {
cat <<EOF
# /etc/exports
# Auto-generated by helix-nfs-apply — do not edit manually.
# Source: $SHARES_CFG
# Regenerate: helix-nfs-apply

EOF

while IFS= read -r section; do
    [[ "$section" == "sharedefaults" ]] && continue

    nfs=$(cfg_get "$section" "nfs" "$SHARES_CFG")
    [[ "$nfs" == "yes" ]] || continue

    # Per-share overrides (fall back to globals if not set)
    network=$(cfg_get "$section" "nfs_network" "$SHARES_CFG" 2>/dev/null || true)
    network="${network:-$NFS_NETWORK}"
    options=$(cfg_get "$section" "nfs_options" "$SHARES_CFG" 2>/dev/null || true)
    options="${options:-$NFS_OPTIONS}"
    path="$USER_SHARE/$section"

    # Exports from the mergerfs (FUSE) user share require an explicit fsid=. Derive a
    # stable one from the share name so it never changes between regenerations.
    case ",$options," in
        *,fsid=*) ;;
        *) options="${options:+$options,}fsid=$(( $(printf '%s' "$section" | cksum | cut -d' ' -f1) % 2147483000 + 1 ))" ;;
    esac

    echo "$path    $network($options)"
done < <(cfg_sections "$SHARES_CFG")
}

if [[ "$DRY_RUN" == "--dry-run" ]]; then
    echo "=== /etc/exports preview (not written) ===" && generate
    exit 0
fi

[[ -f /usr/sbin/exportfs ]] || { echo "NFS not installed. Run: apt install nfs-kernel-server"; exit 1; }

generate > "$OUT"
echo "Written: $OUT"

# Reload exports
if systemctl is-active --quiet nfs-server 2>/dev/null; then
    exportfs -ra && echo "NFS exports reloaded."
elif grep -q '^nfs=yes' "$SHARES_CFG" 2>/dev/null; then
    systemctl start nfs-server 2>/dev/null && echo "nfs-server started." \
        || echo "WARN: could not start nfs-server (check: journalctl -u nfs-server)"
else
    echo "No NFS shares defined — nfs-server left stopped."
fi
