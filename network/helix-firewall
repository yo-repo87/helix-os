#!/usr/bin/env python3
"""helix-firewall — apply the Helix firewall (nftables table `inet helix`). Root only.

    helix-firewall boot                     apply the saved config at boot (first run: learn mode)
    helix-firewall apply [--revert-after N] apply the pending config ($STATE_DIR/firewall.pending.json);
                                            with N, it is undone after N seconds unless confirmed
    helix-firewall confirm                  keep the pending config (saved to $HELIX_CONFIG/firewall.json)
    helix-firewall revert                   go back to the saved config
    helix-firewall off                      turn the firewall off now and in the saved config (console escape hatch)
    helix-firewall status                   JSON: active mode, pending change, revert deadline

The ruleset is generated by the backend's services/firewall.py, so the boot path and the web UI build the same
thing. Each change is one atomic `nft -f` transaction, checked first with `nft -c`.
"""
import json
import os
import subprocess
import sys
import time

BACKEND = os.environ.get("HELIX_BACKEND", "/opt/helix/backend")
sys.path.insert(0, BACKEND)
from config import HELIX_CONFIG, STATE_DIR  # noqa: E402
from services import firewall as fw  # noqa: E402

SAVED = os.path.join(HELIX_CONFIG, "firewall.json")
PENDING = os.path.join(STATE_DIR, "firewall.pending.json")
META = os.path.join(STATE_DIR, "firewall.pending-meta.json")
ACTIVE = os.path.join(STATE_DIR, "firewall.active.json")
REVERT_UNIT = "helix-firewall-revert"
NFT = os.environ.get("HELIX_NFT", "nft")


def sh(cmd, **kw):
    """subprocess.run that never raises: a missing tool (no systemd in a rescue shell) is just a failed call."""
    try:
        return subprocess.run(cmd, capture_output=True, text=True, **kw)
    except OSError as e:
        return subprocess.CompletedProcess(cmd, 127, "", str(e))


def log(msg):
    print(f"[helix-firewall] {msg}", flush=True)


def read(path):
    try:
        with open(path) as f:
            return json.load(f)
    except (OSError, ValueError):
        return None


def write(path, data):
    tmp = path + ".tmp"
    with open(tmp, "w") as f:
        f.write(fw.dumps(data))
    os.replace(tmp, path)
    try:
        os.chown(path, *_helix_ids())
    except (OSError, KeyError):
        pass


def _helix_ids():
    import pwd
    p = pwd.getpwnam("helix")
    return p.pw_uid, p.pw_gid


def nft_apply(cfg) -> None:
    script = fw.generate(cfg)
    if not script:                                   # mode off
        sh([NFT, "delete", "table", "inet", "helix"])
    else:
        chk = sh([NFT, "-c", "-f", "-"], input=script)
        if chk.returncode != 0:
            raise SystemExit("nft rejected the ruleset (nothing changed): " + (chk.stderr.strip() or chk.stdout.strip()))
        r = sh([NFT, "-f", "-"], input=script)
        if r.returncode != 0:
            raise SystemExit("nft could not apply the ruleset: " + r.stderr.strip())
    with open(ACTIVE, "w") as f:
        json.dump({"mode": fw.clean_config(cfg)["mode"], "applied": int(time.time())}, f)


def cancel_revert():
    sh(["systemctl", "stop", f"{REVERT_UNIT}.timer", f"{REVERT_UNIT}.service"])
    sh(["systemctl", "reset-failed", f"{REVERT_UNIT}.timer", f"{REVERT_UNIT}.service"])


def saved_config():
    cfg = read(SAVED)
    return fw.clean_config(cfg) if cfg else None


def cmd_boot():
    cfg = saved_config()
    if cfg is None:
        # First run on this machine (user decision): learn mode. Nothing is blocked; the UI shows what would be.
        cfg = {**fw.default_config(), "mode": "learn", "learn_since": int(time.time())}
        try:
            write(SAVED, cfg)
        except OSError as e:
            log(f"could not save the first-run config ({e}); learn mode for this boot only")
    nft_apply(cfg)
    log(f"applied ({cfg['mode']}, {len(cfg['rules'])} rules)")


def cmd_apply(revert_after):
    cfg = read(PENDING)
    if cfg is None:
        raise SystemExit("no pending firewall change")
    cfg = fw.clean_config(cfg)
    cancel_revert()
    nft_apply(cfg)
    if revert_after:
        # The undo runs this same helper with the same settings (not a fixed path: dev installs and tests differ).
        env = [f"--setenv={k}={os.environ[k]}" for k in ("HELIX_CONFIG", "STATE_DIR", "HELIX_BACKEND", "HELIX_NFT")
               if os.environ.get(k)]
        r = sh(["systemd-run", f"--unit={REVERT_UNIT}", f"--on-active={int(revert_after)}",
                "--timer-property=AccuracySec=1s", *env,
                sys.executable, os.path.abspath(__file__), "revert", "--from-timer"])
        if r.returncode != 0:
            nft_apply(saved_config() or fw.default_config())       # no safety net -> do not keep it
            raise SystemExit("could not schedule the automatic undo, so the change was not kept: " + r.stderr.strip())
        with open(META, "w") as f:
            json.dump({"deadline": int(time.time()) + int(revert_after)}, f)
        log(f"applied ({cfg['mode']}); undone in {revert_after}s unless confirmed")
    else:
        _promote(cfg)
        log(f"applied and saved ({cfg['mode']})")


def _promote(cfg):
    write(SAVED, cfg)
    for p in (PENDING, META):
        try:
            os.unlink(p)
        except OSError:
            pass


def cmd_confirm():
    cfg = read(PENDING)
    if cfg is None:
        raise SystemExit("nothing to confirm (the change was already undone or saved)")
    cancel_revert()
    _promote(fw.clean_config(cfg))
    log("change kept")


def cmd_revert(from_timer=False):
    if not from_timer:            # the timer's own run must not stop its own unit
        cancel_revert()
    cfg = saved_config() or fw.default_config()
    nft_apply(cfg)
    for p in (PENDING, META):
        try:
            os.unlink(p)
        except OSError:
            pass
    log(f"reverted to the saved config ({cfg['mode']})")


def cmd_off():
    cancel_revert()
    cfg = saved_config() or fw.default_config()
    cfg["mode"] = "off"
    nft_apply(cfg)
    try:
        write(SAVED, cfg)
    except OSError as e:
        log(f"firewall is off now, but could not save that ({e}); it comes back at the next boot")
    for p in (PENDING, META):
        try:
            os.unlink(p)
        except OSError:
            pass
    log("firewall off")


def cmd_status():
    table = sh([NFT, "list", "table", "inet", "helix"]).returncode == 0
    meta = read(META) or {}
    active = read(ACTIVE) or {}
    print(json.dumps({"table": table, "active_mode": active.get("mode") if table else "off",
                      "applied": active.get("applied"), "pending": os.path.exists(PENDING),
                      "deadline": meta.get("deadline")}))


def main():
    a = sys.argv[1:]
    if os.geteuid() != 0:
        raise SystemExit("must run as root")
    if a == ["boot"]:
        cmd_boot()
    elif a[:1] == ["apply"]:
        n = int(a[a.index("--revert-after") + 1]) if "--revert-after" in a else 0
        cmd_apply(n)
    elif a == ["confirm"]:
        cmd_confirm()
    elif a[:1] == ["revert"]:
        cmd_revert(from_timer="--from-timer" in a)
    elif a == ["off"]:
        cmd_off()
    elif a == ["status"]:
        cmd_status()
    else:
        raise SystemExit(__doc__)


if __name__ == "__main__":
    main()
